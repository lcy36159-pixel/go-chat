# ===== go-chat .env 範例 =====
# 使用方式：將本檔複製為 `.env`

# JWT 簽章密鑰（必填）
# 注意：長度至少 32 字元，且嚴禁直接使用範例值於正式環境
JWT_SECRET=your-development-only-secret-key-change-this-before-production-2026

# JWT 有效時間（小時，選填）
# 不填時預設為 24
JWT_TTL_HOURS=24

# API 伺服器埠號（選填）
# 不填時預設為 8080
APP_PORT=8080

# ===== PostgreSQL 資料庫設定 =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSLMODE=disable
